#include <stdio.h>

int main() {
    int blocks[] = {1, 3, 5, 3, 1};   
    int n = 5;                        

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < blocks[i]; j++) {
            printf("*\n");
        }
        if (i != n - 1)               
            printf("\n");
    }

    return 0;
}
